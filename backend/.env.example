# Copy this file to .env and replace placeholder values.
# Do not commit the real .env file.

PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=replace-with-a-long-random-secret

# Required for password recovery. Use an independent random secret of at least
# 32 bytes, shared by all API replicas. Never use this placeholder in deployment.
PASSWORD_RECOVERY_SECRET=

# Required for encrypting GPS and route JSON before storing it in PostgreSQL.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCATION_DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/karipa"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/karipa"

# Valhalla routing engine base URL (e.g., http://localhost:8002 for self-hosted or public instance)
VALHALLA_BASE_URL=http://localhost:8002
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ENABLED=true
AI_ROUTE_RANKING_ENABLED=true
# Set GROQ_ENABLED=false to disable all Groq assistance.
# AI_ROUTE_RANKING_ENABLED=false disables only candidate evaluation/ranking.

# Routes more than this distance from the requested target are excluded.
# Default: 0.5 km (set to a positive number to override).
ROUTE_MAX_DISTANCE_DEVIATION_KM=0.5

# Required SMTP settings for registration OTP and password recovery delivery.
# Missing configuration or delivery errors fail; codes are never logged.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@karipa.com

# Optional stable discovery Worker. Required for installed Flutter apps to
# discover new Quick Tunnel URLs automatically.
KARIPA_TUNNEL_DISCOVERY_URL=
KARIPA_TUNNEL_DISCOVERY_TOKEN=
