# Copy this file to .env and replace placeholder values.
# Do not commit the real .env file.

PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=PANDAHAMMER123STRONG

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pathcraft"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pathcraft"

# External services
OSRM_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your-gemini-api-key

# Optional email SMTP settings for OTP delivery.
# If SMTP_HOST/SMTP_USER/SMTP_PASS are not set, the app will log OTP codes instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pathcraft.com
