# Copy this file to .env and replace placeholder values.
# Do not commit the real .env file.

PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=replace-with-a-long-random-secret

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/karipa"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/karipa"

# Valhalla routing engine base URL (e.g., http://localhost:8002 for self-hosted or public instance)
VALHALLA_BASE_URL=http://localhost:8002
GEMINI_API_KEY=your-gemini-api-key
AI_ROUTE_RANKING_ENABLED=true
# Set to false to disable Gemini ranking and use deterministic ranking only.

# Optional. Leave unset until an acceptable target-distance deviation is approved.
# When set, routes outside this positive distance deviation (in km) are excluded.
ROUTE_MAX_DISTANCE_DEVIATION_KM=

# Optional email SMTP settings for OTP delivery.
# If SMTP_HOST/SMTP_USER/SMTP_PASS are not set, the app will log OTP codes instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@karipa.com
